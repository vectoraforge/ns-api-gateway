# App
CONFIG_DIR=config/
OPENAI_API_KEY=...
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nativespeaker

# Tests (e2e)
FIREBASE_API_KEY=...
FIREBASE_TEST_EMAIL=...
FIREBASE_TEST_PASSWORD=...

# Firebase Admin service account (D-08)
# The whole service-account JSON on ONE line, obtained from the Firebase console
# (Project settings -> Service accounts -> Generate new private key).
# Required only for completion-mode requests; every other path runs without it.
# NEVER commit the real value -- it belongs in the gitignored .env, and never in
# config/config.yaml, which is tracked and would silently outrank this variable.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
